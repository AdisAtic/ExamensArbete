{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=prices;Username=admin;Password=nimda"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiSettings": {
    "PriceAgent": {
      "BaseUrl": "https://pk-produkter.localtest.me:5001",
      "FeedEndpoint": "priceagent.axd/lowestprice30daysagent?refresh=true",
      "Authentication": {
        "Method": "Basic",
        "Username": "user-if-needed",
        "Password": "password-if-needed"
      }
    }
  },
  "LitiumSettings": {
    "ServiceAccountToken": "put-your-token-here-if needed",
    "CronExpression":      "0 0 10,22 * * *", //10:00 & 22:00
    "TimeZone":            "Europe/Stockholm"
  },
  "PriceUpdateSettings": {
  "RetentionDays": 180,
  "Parser": {
    "Type": "Xml", 
    "Xml": {
      "ProductXPath":    "//*[local-name()='product']",
      "IdXPath":         "*[local-name()='id']",
      "PriceXPath":      "*[local-name()='price']",
      "SalePriceXPath":  "*[local-name()='sale_price']"
    },
    "Json": {
      "ProductsPath":    "$.items",
      "IdProperty":      "id",
      "PriceProperty":   "price",
      "SalePriceProperty":"salePrice"
    }
  }
},
  "AllowedHosts": "*"
}
